# Consume a matching native build without rebuilding WebRTC for each product.
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
  include("${CMAKE_CURRENT_LIST_DIR}/WebRTCPrebuiltMacOS.cmake")
  return()
endif()
if(NOT WIN32)
  message(FATAL_ERROR "WEBRTC_PREBUILT_DIR supports Windows and macOS Release builds")
endif()
# Legacy Windows builds use /MT. /MD products must supply a stamped matching build.
set(_prebuilt_runtime "MultiThreaded$<$<CONFIG:Debug>:Debug>")
if(EXISTS "${WEBRTC_PREBUILT_DIR}/livekit-msvc-runtime.txt")
  file(READ "${WEBRTC_PREBUILT_DIR}/livekit-msvc-runtime.txt" _prebuilt_runtime)
endif()
if(NOT _prebuilt_runtime STREQUAL CMAKE_MSVC_RUNTIME_LIBRARY)
  message(FATAL_ERROR "WebRTC prebuilt CRT mismatch. Rebuild SDK/WebRTC with the same CMAKE_MSVC_RUNTIME_LIBRARY.")
endif()
set(CMAKE_CONFIGURATION_TYPES Release CACHE STRING "Matching prebuilt configuration" FORCE)
file(GLOB _webrtc_absl "${WEBRTC_PREBUILT_DIR}/lib/Release/absl_*.lib")
if(NOT _webrtc_absl)
  # Application builds may retain third-party archives in their target folders.
  file(GLOB_RECURSE _webrtc_absl "${WEBRTC_PREBUILT_DIR}/sdk/webrtc/third_party/abseil-cpp/absl_*.lib")
  list(FILTER _webrtc_absl INCLUDE REGEX "/Release/absl_[^/]+\\.lib$")
endif()
set(_webrtc_libs "${WEBRTC_PREBUILT_DIR}/Release/webrtc.lib")
foreach(_name webrtc_pffft webrtc_rnnoise aom srtp yuv opus crc32c jsoncpp)
  set(_archive "${WEBRTC_PREBUILT_DIR}/lib/Release/${_name}.lib")
  if(NOT EXISTS "${_archive}")
    set(_folder "${_name}")
    if(_name STREQUAL "srtp")
      set(_folder libsrtp)
    elseif(_name STREQUAL "yuv")
      set(_folder libyuv)
    endif()
    set(_archive "${WEBRTC_PREBUILT_DIR}/sdk/webrtc/third_party/${_folder}/Release/${_name}.lib")
  endif()
  list(APPEND _webrtc_libs "${_archive}")
endforeach()
foreach(_lib IN LISTS _webrtc_libs)
  if(NOT EXISTS "${_lib}")
    message(FATAL_ERROR "Missing WebRTC prebuilt library: ${_lib}")
  endif()
endforeach()
if(NOT _webrtc_absl)
  message(FATAL_ERROR "Missing WebRTC Abseil libraries in WEBRTC_PREBUILT_DIR")
endif()
find_package(unofficial-libvpx CONFIG REQUIRED)
find_package(OpenSSL REQUIRED)
find_library(_webrtc_dav1d NAMES dav1d REQUIRED PATHS "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/lib" NO_DEFAULT_PATH)
add_library(livekit_webrtc_prebuilt INTERFACE)
add_library(WebRTC::webrtc ALIAS livekit_webrtc_prebuilt)
target_include_directories(livekit_webrtc_prebuilt INTERFACE
  "${WEBRTC_SOURCE_DIR}" "${WEBRTC_SOURCE_DIR}/third_party/abseil-cpp" "${WEBRTC_SOURCE_DIR}/third_party/libyuv/include")
target_compile_definitions(livekit_webrtc_prebuilt INTERFACE WEBRTC_WIN WEBRTC_ALLOW_DEPRECATED_NAMESPACES NOMINMAX WIN32_LEAN_AND_MEAN)
target_link_libraries(livekit_webrtc_prebuilt INTERFACE ${_webrtc_libs} ${_webrtc_absl}
  unofficial::libvpx::libvpx ${_webrtc_dav1d} OpenSSL::SSL OpenSSL::Crypto
  ws2_32 winmm iphlpapi secur32 crypt32 bcrypt dmoguids wmcodecdspuuid amstrmid msdmo ole32 oleaut32 strmiids user32 advapi32 shell32)
