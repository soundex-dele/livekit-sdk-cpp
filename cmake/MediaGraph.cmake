include_guard(GLOBAL)
set(LIVEKIT_TYPED_GRAPHFLOW_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../graphflow-cpp-refactor" CACHE PATH "Typed GraphFlow source tree used by SDK engines")
if(NOT TARGET GraphFlow::core)
  add_subdirectory("${LIVEKIT_TYPED_GRAPHFLOW_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}/graphflow-typed" EXCLUDE_FROM_ALL)
endif()
set(_media_sdk_root "${CMAKE_CURRENT_LIST_DIR}/..")
add_library(livekit_media_core INTERFACE)
add_library(LiveKit::MediaCore ALIAS livekit_media_core)
target_compile_features(livekit_media_core INTERFACE cxx_std_17)
target_include_directories(livekit_media_core INTERFACE "${_media_sdk_root}/include")
add_library(livekit_media_graph INTERFACE)
add_library(LiveKit::MediaGraph ALIAS livekit_media_graph)

target_link_libraries(livekit_media_graph INTERFACE LiveKit::MediaCore GraphFlow::core)
