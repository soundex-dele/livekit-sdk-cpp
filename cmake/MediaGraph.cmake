include_guard(GLOBAL)
set(LIVEKIT_GRAPHFLOW_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../graphflow-cpp" CACHE PATH "GraphFlow source tree")
if(NOT TARGET graphflow::core)
  set(GRAPHFLOW_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(GRAPHFLOW_BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(UTOOLKIT_INSTALL OFF CACHE BOOL "" FORCE)
  add_subdirectory("${LIVEKIT_GRAPHFLOW_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}/graphflow" EXCLUDE_FROM_ALL)
endif()
set(_media_sdk_root "${CMAKE_CURRENT_LIST_DIR}/..")
add_library(livekit_media_core INTERFACE)
add_library(LiveKit::MediaCore ALIAS livekit_media_core)
target_compile_features(livekit_media_core INTERFACE cxx_std_20)
target_include_directories(livekit_media_core INTERFACE "${_media_sdk_root}/include")
add_library(livekit_media_graph INTERFACE)
add_library(LiveKit::MediaGraph ALIAS livekit_media_graph)

target_link_libraries(livekit_media_graph INTERFACE LiveKit::MediaCore graphflow::engine)
