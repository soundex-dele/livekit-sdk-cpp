# Consume the matching sibling WebRTC CMake Release build. Keep this opt-in:
# headers, libc++ ABI, external codec dependencies and architecture must match.
if(CMAKE_CONFIGURATION_TYPES)
  set(CMAKE_CONFIGURATION_TYPES Release CACHE STRING "Matching prebuilt configuration" FORCE)
elseif(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
  message(FATAL_ERROR "macOS WEBRTC_PREBUILT_DIR requires CMAKE_BUILD_TYPE=Release")
endif()
set(_webrtc_libs "${WEBRTC_PREBUILT_DIR}/Release/libwebrtc.a")
foreach(_name webrtc_pffft webrtc_rnnoise aom srtp yuv opus crc32c jsoncpp)
  list(APPEND _webrtc_libs "${WEBRTC_PREBUILT_DIR}/lib/lib${_name}.a")
endforeach()
file(GLOB _webrtc_absl "${WEBRTC_PREBUILT_DIR}/lib/libabsl_*.a")
if(NOT _webrtc_absl)
  message(FATAL_ERROR "Missing WebRTC Abseil libraries in WEBRTC_PREBUILT_DIR/lib")
endif()
set(_webrtc_arch "${CMAKE_OSX_ARCHITECTURES}")
if(NOT _webrtc_arch)
  set(_webrtc_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(NOT _webrtc_arch MATCHES "^(x86_64|arm64)$")
  message(FATAL_ERROR "Use one macOS architecture (x86_64 or arm64) per build")
endif()
foreach(_lib IN LISTS _webrtc_libs _webrtc_absl)
  if(NOT EXISTS "${_lib}")
    message(FATAL_ERROR "Missing WebRTC prebuilt library: ${_lib}")
  endif()
  execute_process(COMMAND /usr/bin/lipo "${_lib}" -verify_arch "${_webrtc_arch}"
    RESULT_VARIABLE _arch_result OUTPUT_QUIET ERROR_QUIET)
  if(NOT _arch_result EQUAL 0)
    message(FATAL_ERROR "WebRTC prebuilt library does not contain ${_webrtc_arch}: ${_lib}")
  endif()
endforeach()
find_package(OpenSSL REQUIRED)
find_package(Threads REQUIRED)
find_package(JPEG REQUIRED)
find_path(_webrtc_vpx_include vpx/vpx_encoder.h REQUIRED)
find_library(_webrtc_vpx NAMES vpx REQUIRED)
find_library(_webrtc_dav1d NAMES dav1d REQUIRED)
set(_webrtc_frameworks "")
foreach(_framework Foundation AVFoundation AudioToolbox CoreAudio CoreFoundation AudioUnit CoreGraphics)
  find_library(_webrtc_${_framework} ${_framework} REQUIRED)
  list(APPEND _webrtc_frameworks "${_webrtc_${_framework}}")
endforeach()
add_library(livekit_webrtc_prebuilt INTERFACE)
add_library(WebRTC::webrtc ALIAS livekit_webrtc_prebuilt)
target_compile_features(livekit_webrtc_prebuilt INTERFACE cxx_std_20)
target_include_directories(livekit_webrtc_prebuilt INTERFACE
  "${WEBRTC_SOURCE_DIR}" "${WEBRTC_SOURCE_DIR}/third_party/abseil-cpp"
  "${WEBRTC_SOURCE_DIR}/third_party/libyuv/include" "${_webrtc_vpx_include}")
target_compile_definitions(livekit_webrtc_prebuilt INTERFACE
  WEBRTC_POSIX WEBRTC_MAC WEBRTC_ALLOW_DEPRECATED_NAMESPACES)
if(_webrtc_arch STREQUAL "arm64")
  target_compile_definitions(livekit_webrtc_prebuilt INTERFACE WEBRTC_ARCH_ARM64 WEBRTC_HAS_NEON)
endif()
target_link_libraries(livekit_webrtc_prebuilt INTERFACE
  ${_webrtc_libs} ${_webrtc_absl} ${_webrtc_vpx} ${_webrtc_dav1d}
  OpenSSL::SSL OpenSSL::Crypto JPEG::JPEG Threads::Threads ${_webrtc_frameworks})
