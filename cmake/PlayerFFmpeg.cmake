set(LIVEKIT_FFMPEG_ROOT "" CACHE PATH "FFmpeg shared prefix (include and lib or bin)")
find_path(LIVEKIT_FFMPEG_INCLUDE libavformat/avformat.h HINTS "${LIVEKIT_FFMPEG_ROOT}/include" REQUIRED)
foreach(component avformat avcodec avutil swscale swresample)
  find_library(LIVEKIT_FFMPEG_${component}_LIBRARY NAMES ${component}
    HINTS "${LIVEKIT_FFMPEG_ROOT}/lib" "${LIVEKIT_FFMPEG_ROOT}/bin")
  if(WIN32)
    file(GLOB component_dll "${LIVEKIT_FFMPEG_ROOT}/bin/${component}-*.dll")
    list(LENGTH component_dll dll_count)
    if(NOT dll_count EQUAL 1)
      message(FATAL_ERROR "Expected one ${component} DLL in LIVEKIT_FFMPEG_ROOT/bin")
    endif()
    # Some FFmpeg shared distributions ship .def but no MSVC import libraries.
    if(NOT LIVEKIT_FFMPEG_${component}_LIBRARY AND MSVC)
      file(GLOB component_def "${LIVEKIT_FFMPEG_ROOT}/lib/${component}-*.def")
      list(LENGTH component_def def_count)
      if(NOT def_count EQUAL 1 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "${component} needs an import library or an x64 .def file")
      endif()
      file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/ffmpeg-imports")
      set(import_lib "${CMAKE_CURRENT_BINARY_DIR}/ffmpeg-imports/${component}.lib")
      execute_process(COMMAND "${CMAKE_AR}" /nologo /machine:x64 "/def:${component_def}" "/out:${import_lib}"
        RESULT_VARIABLE import_result OUTPUT_QUIET ERROR_VARIABLE import_error)
      if(NOT import_result EQUAL 0)
        message(FATAL_ERROR "FFmpeg import library generation failed: ${import_error}")
      endif()
      set(LIVEKIT_FFMPEG_${component}_LIBRARY "${import_lib}")
    endif()
  endif()
  if(NOT LIVEKIT_FFMPEG_${component}_LIBRARY)
    message(FATAL_ERROR "Missing FFmpeg ${component} development library; set LIVEKIT_FFMPEG_ROOT")
  endif()
  add_library(livekit_ffmpeg_${component} UNKNOWN IMPORTED GLOBAL)
  set_target_properties(livekit_ffmpeg_${component} PROPERTIES
    IMPORTED_LOCATION "${LIVEKIT_FFMPEG_${component}_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${LIVEKIT_FFMPEG_INCLUDE}")
endforeach()
function(livekit_player_runtime target)
  if(WIN32)
    # Include transitive codec dependencies from this particular FFmpeg build.
    file(GLOB runtime_dlls "${LIVEKIT_FFMPEG_ROOT}/bin/*.dll")
    add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
      ${runtime_dlls} "$<TARGET_FILE_DIR:${target}>" COMMAND_EXPAND_LISTS VERBATIM)
  endif()
endfunction()
