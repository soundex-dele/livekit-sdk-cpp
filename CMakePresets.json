{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/windows-x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_MANIFEST_MODE": "OFF",
        "OPENSSL_USE_STATIC_LIBS": "ON",
        "OPENSSL_MSVC_STATIC_RT": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_SYSROOT": "macosx",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "toolchainFile": "${sourceDir}/cmake/MacOSToolchain.cmake"
    },
    {
      "name": "macos-x86_64",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/out/macos-x86_64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/out/macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "jobs": 3
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-x64",
      "jobs": 4
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64",
      "jobs": 4
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-x64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
