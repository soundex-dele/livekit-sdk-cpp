cmake_minimum_required(VERSION 3.24)
file(GLOB_RECURSE client_sources "${SDK_SOURCE_DIR}/src/backends/livekit/*.cpp"
  "${SDK_SOURCE_DIR}/src/backends/livekit/*.hpp" "${SDK_SOURCE_DIR}/include/livekit/client/*.hpp")
foreach(path IN LISTS client_sources)
  file(READ "${path}" source)
  if(source MATCHES "#include[^\n]*(room_engine|livekit/rtc/|backends/rtc/|backends/webrtc/|backends/transport/|graphflow/|media_graph)")
    message(FATAL_ERROR "Client includes a room engine or media graph: ${path}")
  endif()
endforeach()
# Visual Studio project references prove the actual link closure, not just headers.
if(EXISTS "${BUILD_DIR}/livekit_client.vcxproj")
  set(pending "${BUILD_DIR}/livekit_client.vcxproj")
  set(visited "")
  while(pending)
    list(POP_FRONT pending project)
    if(project IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${project}")
    file(READ "${project}" xml)
    string(REGEX MATCHALL "ProjectReference Include=\"[^\"]+\"" references "${xml}")
    get_filename_component(parent "${project}" DIRECTORY)
    foreach(reference IN LISTS references)
      string(REGEX REPLACE "ProjectReference Include=\"([^\"]+)\"" "\\1" target "${reference}")
      file(TO_CMAKE_PATH "${target}" target)
      if(target MATCHES "(livekit_rtc_backend|livekit_rtc_pipelines|graphflow_engine|livekit_rtc_media|livekit_rtc_native|livekit_rtc_signaling|livekit_rtc_services|livekit_protocol_transport)\\.vcxproj")
        message(FATAL_ERROR "Client links forbidden target: ${target}")
      endif()
      get_filename_component(target "${target}" ABSOLUTE BASE_DIR "${parent}")
      if(EXISTS "${target}")
        list(APPEND pending "${target}")
      endif()
    endforeach()
  endwhile()
endif()
