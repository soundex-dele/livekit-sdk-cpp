# Guard architectural dependency direction without loading devices or a server.
foreach(module media_graph_builder media_resources media_graph_contract)
  foreach(extension hpp cpp)
    set(path "${SDK_SOURCE_DIR}/src/engines/rtc/${module}.${extension}")
    if(NOT EXISTS "${path}")
      continue()
    endif()
    file(READ "${path}" source)
    if(source MATCHES "#include[^\n]*(room_engine|rtc_engine_(impl|control)|livekit/rtc/engine)")
      message(FATAL_ERROR "${module} depends on a room/coordinator header")
    endif()
    if(module MATCHES "media_" AND source MATCHES "TrackGraphRegistry|track_graph_registry")
      message(FATAL_ERROR "${module} depends on the graph registry")
    endif()
  endforeach()
endforeach()
foreach(port publish_node subscribe_node track_endpoint)
  file(READ "${SDK_SOURCE_DIR}/include/livekit/rtc/${port}.hpp" source)
  if(source MATCHES "#include[^\n]*room_engine")
    message(FATAL_ERROR "${port} pulls in the room facade")
  endif()
endforeach()

# Per-call Completion is allowed; the three FIFO workers remain the execution model.
foreach(path include/livekit/rtc/engine.hpp include/livekit/rtc/room_engine.hpp
             src/engines/rtc/rtc_engine.cpp src/backends/rtc/room_engine.cpp)
  file(READ "${SDK_SOURCE_DIR}/${path}" source)
  if(source MATCHES "AsyncResult|OperationGuard|deadline_key|TrackEntry")
    message(FATAL_ERROR "${path} reintroduces operation scheduling machinery")
  endif()
endforeach()

file(READ "${SDK_SOURCE_DIR}/include/livekit/rtc/room_engine.hpp" room_header)
if(room_header MATCHES "struct Impl|class Impl|impl_")
  message(FATAL_ERROR "RoomEngine must own its members directly, without PImpl")
endif()

# The standalone room cannot include a graph/media adapter or create its worker.
foreach(path include/livekit/rtc/room_engine.hpp src/backends/rtc/room_engine.cpp
             src/backends/rtc/execution.hpp)
  file(READ "${SDK_SOURCE_DIR}/${path}" source)
  if(source MATCHES "#include[^\n]*(engines/rtc|graphflow|livekit/rtc/(engine|media_config|graph_api))")
    message(FATAL_ERROR "${path} couples room transport to media orchestration")
  endif()
  if(source MATCHES "rtc.lifecycle|internal_observer_")
    message(FATAL_ERROR "${path} retains media-specific execution behavior")
  endif()
endforeach()
